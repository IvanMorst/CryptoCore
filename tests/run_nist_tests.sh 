#!/bin/bash

# NIST Statistical Test Suite Runner for CryptoCore
# Полный цикл тестирования CSPRNG с выводом результатов

set -e  # Выход при ошибке

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Функции для цветного вывода
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Проверка зависимостей
check_dependencies() {
    print_info "Проверка зависимостей..."

    # Проверка Python
    if ! command -v python3 &> /dev/null; then
        print_error "Python3 не установлен"
        exit 1
    fi

    # Проверка NIST STS
    if [ ! -f "assess" ] && [ ! -f "./assess" ]; then
        print_warning "NIST STS не найден в текущей директории"
        print_info "Скачайте с: https://csrc.nist.gov/CSRC/media/Projects/Random-Bit-Generation/documents/sts-2_1_2.zip"
        print_info "Распакуйте и выполните 'make' в папке sts-2.1.2"
        exit 1
    fi

    # Поиск исполняемого файла assess
    if [ -f "assess" ]; then
        NIST_CMD="./assess"
    elif [ -f "./assess" ]; then
        NIST_CMD="./assess"
    else
        print_error "Не найден исполняемый файл assess"
        exit 1
    fi

    print_success "Все зависимости проверены"
}

# Генерация тестовых данных
generate_test_data() {
    local size_mb=$1
    local output_file=$2

    print_info "Генерация тестовых данных: ${size_mb}MB -> ${output_file}"

    python3 -c "
import sys
sys.path.append('.')
from csprng import generate_random_bytes

total_size = ${size_mb} * 1024 * 1024
chunk_size = 8192
bytes_written = 0

with open('${output_file}', 'wb') as f:
    while bytes_written < total_size:
        chunk = generate_random_bytes(min(chunk_size, total_size - bytes_written))
        f.write(chunk)
        bytes_written += len(chunk)

print(f'Сгенерировано {bytes_written} байт')
"

    if [ $? -eq 0 ] && [ -f "$output_file" ]; then
        local actual_size=$(stat -f%z "$output_file" 2>/dev/null || stat -c%s "$output_file" 2>/dev/null)
        print_success "Тестовые данные созданы: $output_file ($((actual_size / 1024 / 1024))MB)"
    else
        print_error "Ошибка генерации тестовых данных"
        exit 1
    fi
}

# Запуск NIST тестов
run_nist_tests() {
    local input_file=$1
    local bit_length=$2

    print_info "Запуск NIST Statistical Test Suite..."
    print_info "Файл: $input_file"
    print_info "Длина битовой последовательности: $bit_length"

    # Создание временной директории для результатов
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local result_dir="nist_results_${timestamp}"
    mkdir -p "$result_dir"

    # Запуск NIST STS (неинтерактивный режим)
    print_info "Выполнение тестов (это может занять несколько минут)..."

    # Создание конфигурационного файла для неинтерактивного режима
    cat > nist_config.txt << EOF
$bit_length
0
$input_file
0
1
EOF

    # Запуск NIST STS
    $NIST_CMD < nist_config.txt > "$result_dir/nist_output.log" 2>&1

    if [ $? -eq 0 ]; then
        print_success "NIST тесты завершены"
    else
        print_error "Ошибка выполнения NIST тестов"
        exit 1
    fi

    # Копирование результатов
    if [ -d "experiments" ]; then
        cp -r experiments/* "$result_dir/"
        print_success "Результаты сохранены в: $result_dir"
    else
        print_error "Директория experiments не найдена"
        exit 1
    fi

    echo "$result_dir"
}

# Анализ результатов
analyze_results() {
    local result_dir=$1

    print_info "Анализ результатов тестирования..."

    # Поиск файла с итогами
    local summary_file=$(find "$result_dir" -name "finalAnalysisReport.txt" -type f | head -1)

    if [ -z "$summary_file" ] || [ ! -f "$summary_file" ]; then
        print_error "Файл с итогами не найден"
        return 1
    fi

    print_success "Найден файл результатов: $summary_file"

    # Парсинг результатов
    echo
    echo "================================================"
    echo "          РЕЗУЛЬТАТЫ NIST ТЕСТОВ"
    echo "================================================"
    echo

    local total_tests=0
    local passed_tests=0
    local failed_tests=0

    while IFS= read -r line; do
        if [[ $line =~ ^[[:space:]]*[0-9]+\-[[:space:]]+(.*)[[:space:]]+[A-Z]+[[:space:]]+([0-9]+)/([0-9]+) ]]; then
            test_name="${BASH_REMATCH[1]}"
            passed="${BASH_REMATCH[2]}"
            total="${BASH_REMATCH[3]}"

            total_tests=$((total_tests + total))
            passed_tests=$((passed_tests + passed))
            failed_tests=$((failed_tests + (total - passed)))

            if [ "$passed" -eq "$total" ]; then
                echo -e "✅ ${GREEN}$test_name: $passed/$total${NC}"
            elif [ "$passed" -gt $((total * 8 / 10)) ]; then
                echo -e "⚠️  ${YELLOW}$test_name: $passed/$total${NC}"
            else
                echo -e "❌ ${RED}$test_name: $passed/$total${NC}"
            fi
        fi
    done < "$summary_file"

    echo
    echo "================================================"
    echo -e "Итого: ${BLUE}$passed_tests/$total_tests${NC} тестов пройдено"

    # Расчет процента успешных тестов
    local success_rate=$((passed_tests * 100 / total_tests))

    if [ $success_rate -ge 90 ]; then
        echo -e "Статус: ${GREEN}ОТЛИЧНО${NC} ($success_rate% успешных тестов)"
        print_success "CSPRNG проходит NIST тестирование"
    elif [ $success_rate -ge 80 ]; then
        echo -e "Статус: ${YELLOW}ХОРОШО${NC} ($success_rate% успешных тестов)"
        print_warning "CSPRNG в основном проходит тестирование"
    elif [ $success_rate -ge 70 ]; then
        echo -e "Статус: ${YELLOW}УДОВЛЕТВОРИТЕЛЬНО${NC} ($success_rate% успешных тестов)"
        print_warning "Есть некоторые проблемы со случайностью"
    else
        echo -e "Статус: ${RED}НЕУДОВЛЕТВОРИТЕЛЬНО${NC} ($success_rate% успешных тестов)"
        print_error "Серьезные проблемы со случайностью"
    fi

    echo "================================================"

    # Сохранение сводки
    cat > "$result_dir/summary.txt" << EOF
NIST Statistical Test Suite Results
===================================
Total tests: $total_tests
Passed tests: $passed_tests
Failed tests: $failed_tests
Success rate: $success_rate%

Status: $([ $success_rate -ge 90 ] && echo "EXCELLENT" || [ $success_rate -ge 80 ] && echo "GOOD" || [ $success_rate -ge 70 ] && echo "SATISFACTORY" || echo "POOR")

Generated: $(date)
Test file: $(basename "$input_file")
Bit length: $bit_length
EOF
}

# Основная функция
main() {
    echo
    echo "================================================"
    echo "    NIST STATISTICAL TEST SUITE RUNNER"
    echo "         для CryptoCore CSPRNG"
    echo "================================================"
    echo

    # Параметры по умолчанию
    local DATA_SIZE_MB=100  # 100MB тестовых данных
    local TEST_FILE="nist_test_data.bin"
    local BIT_LENGTH=1000000  # 1,000,000 бит (рекомендуется NIST)

    # Обработка аргументов
    while [[ $# -gt 0 ]]; do
        case $1 in
            -s|--size)
                DATA_SIZE_MB="$2"
                shift 2
                ;;
            -f|--file)
                TEST_FILE="$2"
                shift 2
                ;;
            -b|--bits)
                BIT_LENGTH="$2"
                shift 2
                ;;
            -h|--help)
                echo "Использование: $0 [OPTIONS]"
                echo "Options:"
                echo "  -s, --size SIZE_MB    Размер тестовых данных в MB (по умолчанию: 100)"
                echo "  -f, --file FILENAME   Имя тестового файла (по умолчанию: nist_test_data.bin)"
                echo "  -b, --bits BIT_LENGTH Длина битовой последовательности (по умолчанию: 1000000)"
                echo "  -h, --help           Показать эту справку"
                exit 0
                ;;
            *)
                print_error "Неизвестный аргумент: $1"
                exit 1
                ;;
        esac
    done

    # Проверка и подготовка
    check_dependencies

    # Генерация тестовых данных
    generate_test_data "$DATA_SIZE_MB" "$TEST_FILE"

    # Запуск NIST тестов
    result_dir=$(run_nist_tests "$TEST_FILE" "$BIT_LENGTH")

    # Анализ результатов
    analyze_results "$result_dir"

    # Очистка
    if [ -f "nist_config.txt" ]; then
        rm -f "nist_config.txt"
    fi

    print_success "Тестирование завершено!"
    print_info "Полные результаты в: $result_dir"
    print_info "Для детального анализа смотрите файлы в $result_dir/"

    echo
    echo "Быстрая проверка качества CSPRNG:"
    if [ -f "$result_dir/summary.txt" ]; then
        grep -E "Status:|Success rate:" "$result_dir/summary.txt"
    fi
}

# Запуск основной функции
main "$@"